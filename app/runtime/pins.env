# Versions the Android app's bundled programs are built from (build-runtime.sh). Bump deliberately:
# each one was run on a real phone.
ALPINE_BRANCH=v3.24
MUSL_VERSION=1.2.6
CLAUDE_CODE_VERSION=2.1.300
PATCHELF_VERSION=0.18.0
# What the phone runs. nodejs: the backend and hooks; bash: Claude Code's shell; git: sync, projects;
# ripgrep: search; ca-certificates: TLS roots.
RUNTIME_PACKAGES="nodejs bash git ripgrep ca-certificates"
# name:path inside the Alpine tree. The name is what PATH sees.
RUNTIME_EXECUTABLES="node:usr/bin/node bash:bin/bash git:usr/bin/git git-remote-https:usr/libexec/git-core/git-remote-https rg:usr/bin/rg"
# What building the shim and node-pty needs (headers, libstdc++, compiler-rt for musl).
SYSROOT_PACKAGES="musl-dev libstdc++-dev libstdc++ libgcc gcc linux-headers nodejs-dev musl compiler-rt"
