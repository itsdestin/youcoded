<?xml version="1.0" encoding="utf-8"?>
<!-- Dark mode's copy of the adaptive icon. The only difference is the themed (one-colour) layer: on a dark
     home screen Android draws it light, so it is the SOLID face with the eyes cut out, which then reads like
     the real icon (dark eyes, white sparkles). The light-mode copy keeps the outline face, which reads right
     drawn dark on a light home screen. Destin's pick, 2026-10-15 (android-icon-choice I-1).
     Generated per density by youcoded/scripts/build-icons.mjs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome_night" />
</adaptive-icon>
