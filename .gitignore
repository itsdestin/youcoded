*.iml
.gradle
/local.properties
/.idea
/build
/app/build
/captures
.externalNativeBuild
.cxx
local.properties

# YouCoded local Claude Code settings (caches, topic markers, etc.).
# Tracked rule files under .claude/rules/ are explicitly un-ignored so
# they ship with the repo and auto-surface invariants to contributors.
# Note: .claude/* (not .claude/) is required so git descends into the
# directory and honors the negation patterns below.
.claude/*
!.claude/rules/
!.claude/rules/**

# Release signing
*.jks
*.keystore
keystore.properties
# Exception: debug keystore is publicly known (password "android") and is
# intentionally committed so every dev build shares one signing key.
!app/debug.keystore

# Drafts and temp files
icon-drafts/
tmp-screenshots/
screenshot.png

# Git worktrees (isolated feature workspaces). BOTH spellings: the superpowers
# skill defaults to the hidden `.worktrees/`, but run-dev.sh and every session
# in this workspace actually use `worktrees/`. Only the dotted one was listed
# here, so real worktrees showed up as untracked noise in every `git status`.
.worktrees/
worktrees/

# Desktop app (Electron)
# No trailing slash: also ignores a `node_modules` symlink (a dev worktree
# pointing its deps at a sibling checkout), not just a real directory.
node_modules
desktop/dist/
desktop/build/
desktop/release/
# Gradle build output for the vendored Termux terminal-emulator module
terminal-emulator-vendored/build/
# Electron runtime debug logs — machine-specific, leak local paths
*.log

# Built React UI bundle (copied from desktop build). Nothing here is tracked:
# Gradle's bundleWebUi task regenerates the folder before every APK build.
app/src/main/assets/web/
.superpowers/
