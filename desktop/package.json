{
  "name": "youcoded",
  "version": "1.2.4",
  "description": "Desktop GUI for Claude Code with the YouCoded toolkit",
  "homepage": "https://github.com/itsdestin/youcoded",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/run-dev.js",
    "dev:main": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/main/pty-worker.js','dist/main/pty-worker.js')\" && electron .",
    "dev:renderer": "vite",
    "build": "tsc && node -e \"require('fs').cpSync('src/main/pty-worker.js','dist/main/pty-worker.js')\" && node -e \"require('fs').mkdirSync('dist/renderer/data',{recursive:true})\" && node -e \"require('fs').cpSync('src/renderer/data/skill-registry.json','dist/renderer/data/skill-registry.json')\" && vite build && electron-builder",
    "build:main": "tsc",
    "build:site": "VITE_WORKBENCH=1 vite build --outDir ../../../docs/site --emptyOutDir",
    "test": "vitest",
    "knip": "knip",
    "lint": "eslint",
    "postinstall": "node scripts/patch-node-pty.js && node scripts/patch-xterm-webgl-mipmap.js"
  },
  "keywords": [],
  "author": "itsdestin",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.47",
    "@ai-sdk/google": "^4.0.61",
    "@ai-sdk/openai": "^4.0.55",
    "@ai-sdk/openai-compatible": "^3.0.42",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "0.6.0",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.89",
    "bcryptjs": "^3.0.3",
    "chess.js": "1.4.0",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "exceljs": "^4.4.0",
    "koffi": "^2.16.3",
    "linkedom": "0.18.13",
    "mammoth": "^1.12.2",
    "node-machine-id": "^1.1.12",
    "node-pty": "1.2.0-beta.12",
    "partysocket": "^1.3.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "turndown": "7.2.4",
    "ulid": "^3.0.2",
    "unist-util-visit-parents": "^6.0.2",
    "which": "^7.0.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/headless": "^6.0.0",
    "ajv": "^8.20.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "unified": "^11.0.5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "electron": true,
    "node-pty": false,
    "koffi": false,
    "electron-winstaller": false
  }
}
