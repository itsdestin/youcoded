{
  "name": "youcoded",
  "version": "1.3.0",
  "description": "Open-source, multi-model AI assistant for your files, projects, and everyday work",
  "homepage": "https://github.com/itsdestin/youcoded",
  "main": "dist/main/bootstrap.js",
  "scripts": {
    "dev": "node scripts/run-dev.js",
    "dev:main": "node scripts/fetch-office.mjs && node scripts/generate-preload-channels.mjs && tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/main/pty-worker.js','dist/main/pty-worker.js')\" && electron .",
    "dev:renderer": "vite",
    "build": "node scripts/fetch-office.mjs --release --required && node scripts/generate-preload-channels.mjs && tsc && node -e \"require('fs').cpSync('src/main/pty-worker.js','dist/main/pty-worker.js')\" && node -e \"require('fs').mkdirSync('dist/renderer/data',{recursive:true})\" && node -e \"require('fs').cpSync('src/renderer/data/skill-registry.json','dist/renderer/data/skill-registry.json')\" && vite build && electron-builder",
    "build:main": "node scripts/generate-preload-channels.mjs && tsc",
    "build:web": "node -e \"require('fs').mkdirSync('dist/renderer/data',{recursive:true})\" && node -e \"require('fs').cpSync('src/renderer/data/skill-registry.json','dist/renderer/data/skill-registry.json')\" && vite build",
    "build:site": "VITE_WORKBENCH=1 vite build --outDir ../../../docs/site --emptyOutDir",
    "test": "vitest",
    "knip": "node scripts/knip-ratchet.js",
    "lint": "oxlint --type-aware",
    "postinstall": "node scripts/patch-node-pty.js && node scripts/patch-xterm-webgl-mipmap.js",
    "typecheck": "node scripts/generate-preload-channels.mjs --check && tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json",
    "lint:design": "oxlint -c .oxlintrc.design.json --format default --max-warnings 537"
  },
  "keywords": [],
  "author": "itsdestin",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "0.6.0",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.127",
    "bcryptjs": "^3.0.3",
    "chess.js": "1.4.0",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "exceljs": "^4.4.0",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.2",
    "koffi": "^2.16.3",
    "linkedom": "0.18.13",
    "mammoth": "^1.13.0",
    "node-machine-id": "^1.1.12",
    "node-pty": "1.2.0-beta.12",
    "partysocket": "^1.3.0",
    "pdfjs-dist": "^6.4.299",
    "pngjs": "^7.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "turndown": "7.2.4",
    "ulid": "^3.0.2",
    "unist-util-visit-parents": "^6.0.2",
    "which": "^7.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.8",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "acorn": "^8.18.0",
    "ajv": "^8.20.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "knip": "^6.39.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron": true,
    "node-pty": false,
    "koffi": false,
    "electron-winstaller": false
  }
}
