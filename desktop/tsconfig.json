// WHY moduleResolution "bundler" (was "node", i.e. node10): node10 is deprecated
// in TypeScript 6 and REMOVED in TypeScript 7. tsgo (the fast type check in
// scripts/verify.sh) and oxlint's type-aware engine are both built on TypeScript
// 7 and refuse this file outright while it says "node". TypeScript 6 is the first
// version that allows "bundler" alongside `module: commonjs`, so the build keeps
// emitting CommonJS unchanged — resolution only decides where types are looked up.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*"],
  // WHY the two *.test.ts(x) globs: this is the BUILD config (rootDir "src",
  // outDir "dist" — `npm run build:main` emits from it), and it type-checks
  // whatever "src/**/*" matches, test files included. tsconfig.tests.json
  // already covers every test file properly (rootDir ".", so it can see both
  // src/ and tests/ in one program). A src-local test file that imports a
  // shared helper from tests/helpers/ (useChunkedReveal's test does, and every
  // list this hook moves onto will have one) trips THIS config's rootDir
  // check with TS6059, because "src" can't contain a file living under
  // tests/. Test files were never meant to compile into dist anyway.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
