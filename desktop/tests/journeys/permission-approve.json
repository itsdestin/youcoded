{
  "start": {
    "scenario": "empty",
    "screen": null,
    "width": 1440,
    "height": 900,
    "theme": "meadow-mist",
    "latency": 0,
    "params": "reply=inbox&replySpeed=4"
  },
  "steps": [
    {
      "do": "click",
      "target": {
        "role": "button",
        "label": "Create Session",
        "nth": 1
      }
    },
    {
      "do": "expect",
      "text": "Initializing session",
      "not": true
    },
    {
      "do": "type",
      "target": {
        "role": "textbox",
        "label": "Message your assistant...",
        "nth": 1
      },
      "text": "check my mail"
    },
    {
      "do": "key",
      "key": "Enter"
    },
    {
      "do": "expect",
      "text": "Three need you"
    },
    {
      "do": "expect",
      "text": "Creating a file"
    },
    {
      "do": "click",
      "target": {
        "role": "button",
        "label": "Yes",
        "nth": 1
      }
    },
    {
      "do": "expect",
      "text": "for your review. Now the invites.",
      "why": "One sentence, checked whole, on purpose: it is ONE streamed reply and must draw as ONE bubble. A permission ask that jumped ahead of still-queued words split it in two (fixed in 1dbadd18c, 2026-09-28: a hook flushes the transcript batch first). Checking each half separately hid that bug, so keep it whole."
    },
    {
      "do": "expect",
      "text": "Google Calendar: Create Event"
    },
    {
      "do": "click",
      "target": {
        "role": "button",
        "label": "Yes",
        "nth": 1
      }
    },
    {
      "do": "expect",
      "text": "Both on your calendar"
    }
  ]
}
