{
  "name": "Morning Rounds",
  "slug": "morning-rounds",
  "version": "1.0.1",
  "dark": false,
  "author": "itsdestin",
  "created": "2026-09-21",
  "description": "Warm paper and carnelian, with an illustrated dog and cat in scrubs. A daylight theme for vet students \u2014 the buddy is the dog from the picture.",
  "tokens": {
    "canvas": "#FAF6F0",
    "panel": "#F3EDE3",
    "inset": "#E3DACC",
    "well": "#E6DED1",
    "accent": "#B31B1B",
    "on-accent": "#FFFFFF",
    "fg": "#2A2320",
    "fg-2": "#574C44",
    "fg-dim": "#6B5F56",
    "fg-muted": "#7D7268",
    "fg-faint": "#9A9184",
    "edge": "#CBBFAE",
    "edge-dim": "#C0B4A380",
    "scrollbar-thumb": "#B31B1B",
    "scrollbar-hover": "#C31230"
  },
  "shape": {
    "radius": "6px",
    "radius-sm": "6px",
    "radius-md": "10px",
    "radius-lg": "16px",
    "radius-full": "9999px"
  },
  "font": {
    "family": "'Nunito', 'Cascadia Mono', monospace",
    "google-font-url": "https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap"
  },
  "background": {
    "type": "image",
    "value": "assets/wallpaper-b.jpg",
    "terminal-value": "assets/wallpaper-terminal.webp",
    "panels-blur": 14,
    "panels-opacity": 0.68,
    "bubble-blur": 12,
    "bubble-opacity": 0.85,
    "average-color": "#E3D6CC",
    "opacity": 1
  },
  "layout": {
    "chrome-style": "default",
    "input-style": "default",
    "bubble-style": "default",
    "header-style": "default",
    "statusbar-style": "default"
  },
  "effects": {
    "particles": "dust",
    "vignette": 0.08,
    "noise": 0.03,
    "scan-lines": false
  },
  "mascot": {
    "idle": "assets/mascot-idle.svg",
    "welcome": "assets/mascot-welcome.svg",
    "inquisitive": "assets/mascot-inquisitive.svg",
    "shocked": "assets/mascot-shocked.svg",
    "rig": "assets/mascot-rig.svg"
  },
  "custom_css": "::selection { background: rgba(179, 27, 27, 0.28); color: var(--fg); } [data-theme=\"morning-rounds\"] button:focus-visible, [data-theme=\"morning-rounds\"] a:focus-visible, [data-theme=\"morning-rounds\"] select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; box-shadow: 0 0 8px rgba(179, 27, 27, 0.3); }"
}
